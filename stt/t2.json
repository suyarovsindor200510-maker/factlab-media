{"lang": "uz", "prob": 1, "segments": [{"s": 0.0, "e": 2.14, "t": " Kok-choy, yo, ko'k, ko'k choy.", "w": [[0.0, 0.4, " Kok"], [0.4, 0.68, "-choy,"], [0.8, 1.0, " yo,"], [1.36, 1.4, " ko"], [1.4, 1.4, "'k,"], [1.48, 1.74, " ko"], [1.74, 1.84, "'k"], [1.84, 2.14, " choy."]]}, {"s": 2.28, "e": 4.82, "t": " Tukhteng, ikialascham bitte būtane bergye.", "w": [[2.28, 2.72, " Tukhteng,"], [2.98, 3.64, " ikialascham"], [3.64, 4.06, " bitte"], [4.06, 4.38, " būtane"], [4.38, 4.82, " bergye."]]}, {"s": 4.96, "e": 5.26, "t": " Nema?", "w": [[4.96, 5.26, " Nema?"]]}, {"s": 5.68, "e": 8.66, "t": " Nekhe ber kok, ber qara, uc raound te belibalamz.", "w": [[5.68, 5.94, " Nekhe"], [5.94, 6.06, " ber"], [6.06, 6.26, " kok,"], [6.54, 6.74, " ber"], [6.74, 7.0, " qara,"], [7.2, 7.5, " uc"], [7.5, 7.82, " raound"], [7.82, 7.98, " te"], [7.98, 8.66, " belibalamz."]]}, {"s": 8.92, "e": 10.78, "t": " Kog borčekte, Samarqand, ko'k choy.", "w": [[8.92, 9.16, " Kog"], [9.16, 9.62, " borčekte,"], [9.88, 10.34, " Samarqand,"], [10.4, 10.54, " ko"], [10.54, 10.62, "'k"], [10.62, 10.78, " choy."]]}, {"s": 11.06, "e": 12.88, "t": " Qizil borčekte, Toshkendan, ko'k choy.", "w": [[11.06, 11.46, " Qizil"], [11.46, 11.88, " borčekte,"], [11.96, 12.44, " Toshkendan,"], [12.54, 12.58, " ko"], [12.58, 12.8, "'k"], [12.8, 12.88, " choy."]]}, {"s": 13.32, "e": 16.42, "t": " Berinče raound, berg uzilde, yollara ayrıldde.", "w": [[13.32, 13.88, " Berinče"], [13.88, 14.18, " raound,"], [14.56, 14.92, " berg"], [14.92, 15.22, " uzilde,"], [15.68, 16.06, " yollara"], [16.06, 16.42, " ayrıldde."]]}, {"s": 16.56, "e": 19.54, "t": " Kok-choy bergene darral kazandhe, yaki buhda qizdere shadhe.", "w": [[16.56, 16.78, " Kok"], [16.78, 17.0, "-choy"], [17.0, 17.36, " bergene"], [17.36, 17.78, " darral"], [17.78, 18.32, " kazandhe,"], [18.44, 18.64, " yaki"], [18.64, 19.0, " buhda"], [19.0, 19.28, " qizdere"], [19.28, 19.54, " shadhe."]]}, {"s": 19.7, "e": 21.66, "t": " Sik bergene qaraishene tukhtetadhe.", "w": [[19.7, 20.14, " Sik"], [20.14, 20.58, " bergene"], [20.58, 21.1, " qaraishene"], [21.1, 21.66, " tukhtetadhe."]]}, {"s": 21.84, "e": 22.98, "t": " Berg, yashil kaladhe.", "w": [[21.84, 22.24, " Berg,"], [22.34, 22.66, " yashil"], [22.66, 22.98, " kaladhe."]]}, {"s": 23.18, "e": 25.96, "t": " Anah, taze, tabi'i, yashil.", "w": [[23.18, 23.5, " Anah,"], [23.72, 24.14, " taze,"], [24.56, 24.94, " tabi"], [24.94, 25.2, "'i,"], [25.3, 25.96, " yashil."]]}, {"s": 25.96, "e": 28.6, "t": " Qara-choy bergene silderib, ezib burashadhe.", "w": [[25.96, 26.36, " Qara"], [26.36, 26.52, "-choy"], [26.52, 26.84, " bergene"], [26.84, 27.52, " silderib,"], [27.76, 28.06, " ezib"], [28.06, 28.6, " burashadhe."]]}, {"s": 28.8, "e": 30.08, "t": " Geyin, hawa da kalra shadhe.", "w": [[28.8, 29.16, " Geyin,"], [29.34, 29.46, " hawa"], [29.46, 29.58, " da"], [29.58, 29.82, " kalra"], [29.82, 30.08, " shadhe."]]}, {"s": 30.26, "e": 32.0, "t": " Alban kezb, ko'y sengiz, nama boladhe.", "w": [[30.26, 30.56, " Alban"], [30.56, 30.9, " kezb,"], [30.9, 30.98, " ko"], [30.98, 31.04, "'y"], [31.04, 31.4, " sengiz,"], [31.5, 31.68, " nama"], [31.68, 32.0, " boladhe."]]}, {"s": 32.26, "e": 32.68, "t": " Qara-yadhe.", "w": [[32.26, 32.44, " Qara"], [32.44, 32.68, "-yadhe."]]}, {"s": 32.98, "e": 34.42, "t": " Choy bergiham, khud dushunday.", "w": [[32.98, 33.14, " Choy"], [33.14, 33.62, " bergiham,"], [33.94, 34.04, " khud"], [34.04, 34.42, " dushunday."]]}, {"s": 35.38, "e": 37.98, "t": " Demak, qara-choy, hawa da qara-ygan berghe kendhe.", "w": [[35.38, 35.9, " Demak,"], [36.0, 36.24, " qara"], [36.24, 36.5, "-choy,"], [36.6, 36.8, " hawa"], [36.8, 36.96, " da"], [36.96, 37.18, " qara"], [37.18, 37.34, "-ygan"], [37.34, 37.7, " berghe"], [37.7, 37.98, " kendhe."]]}, {"s": 38.08, "e": 39.84, "t": " Qara-ygan imaz, pishkan.", "w": [[38.08, 38.48, " Qara"], [38.48, 38.66, "-ygan"], [38.66, 39.12, " imaz,"], [39.28, 39.84, " pishkan."]]}, {"s": 40.2, "e": 41.98, "t": " Alumlar bunu, oksidlanışte idhe.", "w": [[40.2, 40.72, " Alumlar"], [40.72, 40.9, " bunu,"], [41.2, 41.86, " oksidlanışte"], [41.86, 41.98, " idhe."]]}, {"s": 42.24, "e": 43.92, "t": " Damlangan choy isa, qizgish chikadhe.", "w": [[42.24, 42.66, " Damlangan"], [42.66, 42.92, " choy"], [42.92, 43.16, " isa,"], [43.34, 43.62, " qizgish"], [43.62, 43.92, " chikadhe."]]}, {"s": 44.08, "e": 46.4, "t": " Shunin chun, htayda, unu nama, qizil choy.", "w": [[44.08, 44.36, " Shunin"], [44.36, 44.52, " chun,"], [44.64, 44.94, " htayda,"], [45.02, 45.16, " unu"], [45.16, 45.48, " nama,"], [45.8, 46.14, " qizil"], [46.14, 46.4, " choy."]]}, {"s": 46.88, "e": 48.34, "t": " Ikkinci raound, kafein.", "w": [[46.88, 47.3, " Ikkinci"], [47.3, 47.58, " raound,"], [47.88, 48.34, " kafein."]]}, {"s": 48.54, "e": 50.1, "t": " Kok-choyda, otdiz milligram cha.", "w": [[48.54, 48.74, " Kok"], [48.74, 49.04, "-choyda,"], [49.18, 49.54, " otdiz"], [49.54, 49.94, " milligram"], [49.94, 50.1, " cha."]]}, {"s": 50.1, "e": 51.9, "t": " Qara-da, ellik milligram cha.", "w": [[50.1, 50.68, " Qara"], [50.68, 50.82, "-da,"], [51.02, 51.34, " ellik"], [51.34, 51.74, " milligram"], [51.74, 51.9, " cha."]]}, {"s": 52.08, "e": 54.04, "t": " Ana, shunin uchun menchak kama.", "w": [[52.08, 52.4, " Ana,"], [52.72, 53.1, " shunin"], [53.1, 53.38, " uchun"], [53.38, 53.8, " menchak"], [53.8, 54.04, " kama."]]}, {"s": 54.2, "e": 55.48, "t": " Meen isa, khatir jammer.", "w": [[54.2, 54.52, " Meen"], [54.52, 54.76, " isa,"], [54.84, 55.12, " khatir"], [55.12, 55.48, " jammer."]]}, {"s": 55.82, "e": 57.28, "t": " Qafir-da isa, yüzga yakın.", "w": [[55.82, 56.16, " Qafir"], [56.16, 56.24, "-da"], [56.24, 56.48, " isa,"], [56.64, 57.02, " yüzga"], [57.02, 57.28, " yakın."]]}, {"s": 57.56, "e": 58.94, "t": " Unin yaldada ikkala-sukhan bala.", "w": [[57.56, 57.72, " Unin"], [57.72, 58.0, " yaldada"], [58.0, 58.32, " ikkala"], [58.32, 58.64, "-sukhan"], [58.64, 58.94, " bala."]]}, {"s": 59.34, "e": 61.0, "t": " Uchinci raound, damlash.", "w": [[59.34, 59.86, " Uchinci"], [59.86, 60.22, " raound,"], [60.56, 61.0, " damlash."]]}, {"s": 61.38, "e": 63.88, "t": " Kok-choyna qayna qaynaq suda damlashangis, atchik boladhe.", "w": [[61.38, 61.5, " Kok"], [61.5, 61.76, "-choyna"], [61.76, 62.06, " qayna"], [62.06, 62.18, " qaynaq"], [62.18, 62.38, " suda"], [62.38, 63.02, " damlashangis,"], [63.22, 63.52, " atchik"], [63.52, 63.88, " boladhe."]]}, {"s": 63.98, "e": 66.26, "t": " Nama, kırk yildan beri, notogru damlashapamma?", "w": [[63.98, 64.2, " Nama,"], [64.5, 64.72, " kırk"], [64.72, 65.04, " yildan"], [65.04, 65.26, " beri,"], [65.32, 65.64, " notogru"], [65.64, 66.26, " damlashapamma?"]]}, {"s": 66.48, "e": 67.6, "t": " Su, sal-saawasin.", "w": [[66.48, 66.84, " Su,"], [66.94, 67.1, " sal"], [67.1, 67.6, "-saawasin."]]}, {"s": 67.8, "e": 68.54, "t": " Saksan dara-caca.", "w": [[67.8, 68.18, " Saksan"], [68.18, 68.34, " dara"], [68.34, 68.54, "-caca."]]}, {"s": 68.74, "e": 70.56, "t": " Qara-choygi isa qaynaq su, qya-varin.", "w": [[68.74, 69.04, " Qara"], [69.04, 69.3, "-choygi"], [69.3, 69.5, " isa"], [69.5, 69.9, " qaynaq"], [69.9, 70.02, " su,"], [70.18, 70.38, " qya"], [70.38, 70.56, "-varin."]]}, {"s": 70.98, "e": 72.36, "t": " Qoš, qalib kem?", "w": [[70.98, 71.46, " Qoš,"], [71.64, 72.16, " qalib"], [72.16, 72.36, " kem?"]]}, {"s": 72.48, "e": 74.92, "t": " Durang, ikkala-siyam, bitta butanin barge kuk.", "w": [[72.48, 72.94, " Durang,"], [73.18, 73.56, " ikkala"], [73.56, 73.86, "-siyam,"], [73.9, 74.12, " bitta"], [74.12, 74.46, " butanin"], [74.46, 74.78, " barge"], [74.78, 74.92, " kuk."]]}, {"s": 74.92, "e": 87.64, "t": " Qa-kala-siyam, bitta butanin barge kama.", "w": [[74.92, 75.54, " Qa"], [75.54, 75.76, "-kala"], [75.76, 76.96, "-siyam,"], [76.96, 77.42, " bitta"], [77.42, 81.5, " butanin"], [81.5, 87.54, " barge"], [87.54, 87.64, " kama."]]}]}